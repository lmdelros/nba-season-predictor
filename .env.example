# Settings for docker-compose.prod.yml. Copy this file to .env on the server and fill
# in your database's values. .env is ignored by Git, so the password never reaches the
# repository; keep the real file readable only by you (chmod 600 .env).

# Endpoint of the managed database, e.g. the RDS "Endpoint" shown in the AWS console.
DB_HOST=your-database-endpoint.example.com
DB_PORT=5432
DB_NAME=nba_predictor
DB_USER=nba_admin
DB_PASSWORD=change-me
